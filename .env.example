# ============================================================
# Zakat Insight - Environment Variables Configuration Example
# ============================================================
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN commit file .env ke version control!

# ----------------------------------------------------------
# Aplikasi
# ----------------------------------------------------------
# Mode lingkungan: development | staging | production
APP_ENV=development

# Secret key untuk JWT signing (minimal 32 karakter, acak dan aman di production).
# Dengan APP_ENV=production, aplikasi MENOLAK start jika nilai ini masih bawaan
# atau kurang dari 32 karakter. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-secret-key-ganti-di-production-32chars

# Versi aplikasi
APP_VERSION=2.0.0

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# SQLite (development):
DATABASE_URL=sqlite:///zakat_insight.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/zakat_insight

# ----------------------------------------------------------
# Email (SMTP) - WAJIB di production (verifikasi akun & reset sandi)
# ----------------------------------------------------------
EMAIL_ENABLED=false
# Host SMTP penyedia email transaksional (lihat docs/PANDUAN_DEPLOY.md)
EMAIL_SMTP_HOST=
# 587 (STARTTLS) atau 465 (SSL). 2525 bila penyedia mendukung. Port 25 diblokir Render.
EMAIL_SMTP_PORT=587
# starttls | ssl (kosong = ssl bila port 465). TLS tidak bisa dimatikan.
EMAIL_SMTP_TLS=
EMAIL_SMTP_TIMEOUT=15
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# Alamat pengirim di domain yang sudah diverifikasi di penyedia email
EMAIL_FROM=noreply@domain-anda.id
# Alamat publik aplikasi (https di production), untuk tautan di email
APP_BASE_URL=http://localhost:8501

# ----------------------------------------------------------
# Penyimpanan berkas unggahan
# ----------------------------------------------------------
# lokal (UPLOAD_DIR) | s3 (penyimpanan objek kompatibel S3; wajib di Render tanpa disk permanen)
PENYIMPANAN=lokal
UPLOAD_DIR=uploads
# Untuk PENYIMPANAN=s3:
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_AWALAN=unggahan
S3_SSE=
# Hapus otomatis unggahan setelah N hari (0 = tidak pernah)
RETENSI_UNGGAHAN_HARI=0
MAX_UPLOAD_SIZE_MB=50

# ----------------------------------------------------------
# IP klien, batas laju, retensi IP
# ----------------------------------------------------------
# Kosong = tidak ada proxy dipercaya (lokal). Render: render
PROXY_TEPERCAYA=
IP_HEADER_KLIEN=
# jumlah/detik per IP
BATAS_LOGIN_IP=20/900
BATAS_DAFTAR_IP=5/3600
BATAS_RESET_IP=5/3600
BATAS_VERIFIKASI_IP=5/3600
# IP & user agent di log audit dikosongkan setelah N hari
IP_RETENSI_HARI=90

# ----------------------------------------------------------
# Observabilitas
# ----------------------------------------------------------
LOG_LEVEL=INFO
# json | teks
LOG_FORMAT=teks
# Opsional: pemantau galat Sentry (kosong = nonaktif)
SENTRY_DSN=

# ----------------------------------------------------------
# Keamanan & JWT
# ----------------------------------------------------------
# Masa berlaku access token (dalam jam)
JWT_ACCESS_EXPIRE_HOURS=8

# Masa berlaku refresh token (dalam hari)
JWT_REFRESH_EXPIRE_DAYS=30

# Maksimal percobaan login gagal sebelum akun dikunci
LOGIN_MAX_ATTEMPTS=5

# Durasi penguncian akun (dalam menit)
LOGIN_LOCKOUT_MINUTES=15

# ----------------------------------------------------------
# Super Admin
# ----------------------------------------------------------
# Email akun super admin default
SUPERADMIN_EMAIL=admin@zakatinsight.id
