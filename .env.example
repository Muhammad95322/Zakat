# ============================================================
# Zakat Insight - Environment Variables Configuration Example
# ============================================================
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN commit file .env ke version control!

# ----------------------------------------------------------
# Aplikasi
# ----------------------------------------------------------
# Mode lingkungan: development | staging | production
APP_ENV=development

# Secret key untuk JWT signing (minimal 32 karakter, acak dan aman di production).
# Dengan APP_ENV=production, aplikasi MENOLAK start jika nilai ini masih bawaan
# atau kurang dari 32 karakter. Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-secret-key-ganti-di-production-32chars

# Versi aplikasi
APP_VERSION=2.0.0

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# SQLite (development):
DATABASE_URL=sqlite:///zakat_insight.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/zakat_insight

# ----------------------------------------------------------
# Email (SMTP)
# ----------------------------------------------------------
# Aktifkan pengiriman email (true/false)
EMAIL_ENABLED=false

# Host SMTP server
EMAIL_SMTP_HOST=smtp.gmail.com

# Port SMTP (587 untuk TLS, 465 untuk SSL)
EMAIL_SMTP_PORT=587

# Kredensial SMTP
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-app-password

# Alamat pengirim email
EMAIL_FROM=noreply@zakatinsight.id

# ----------------------------------------------------------
# Penyimpanan File
# ----------------------------------------------------------
# Direktori penyimpanan file upload
UPLOAD_DIR=uploads

# Ukuran maksimal upload per file (dalam MB)
MAX_UPLOAD_SIZE_MB=50

# ----------------------------------------------------------
# Keamanan & JWT
# ----------------------------------------------------------
# Masa berlaku access token (dalam jam)
JWT_ACCESS_EXPIRE_HOURS=8

# Masa berlaku refresh token (dalam hari)
JWT_REFRESH_EXPIRE_DAYS=30

# Maksimal percobaan login gagal sebelum akun dikunci
LOGIN_MAX_ATTEMPTS=5

# Durasi penguncian akun (dalam menit)
LOGIN_LOCKOUT_MINUTES=15

# ----------------------------------------------------------
# Super Admin
# ----------------------------------------------------------
# Email akun super admin default
SUPERADMIN_EMAIL=admin@zakatinsight.id
